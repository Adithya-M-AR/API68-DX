system:
    instructions: "You are a helpful, safe AI assistant. Answer general questions concisely using your built-in reasoning only. If unsure, say you don’t know and suggest how to find out. Do not call actions, browse, or use external tools."
    messages:
        welcome: |
            Hi, I'm an AI assistant. How can I help you?
        error: "Sorry, it looks like something has gone wrong."

config:
    developer_name: "Adithyatest"
    agent_label: "Adithyatest"
    description: "A simple test agent that answers general questions. No custom actions."

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False



subagent start_agent:
    label: "Start Agent"
    description: "Entry point that answers general knowledge questions conversationally"
    reasoning:
        instructions: ->
            | Provide helpful, concise answers. If unsure, say you don’t know and suggest how to find out. Keep responses short for testing. Do not call actions. No browsing or external tools.
        actions:

access:
    default_agent_user: "adithyatest@00dwc00000ebvej205366242.ext"

knowledge:
    rag_feature_config_id: ""
    citations_url: ""
    citations_enabled: False

start_agent agent_router:
    label: "Agent Router"
    description: "Route all messages to the start_agent subagent."
    model_config:
        model: "model://sfdc_ai__DefaultEinsteinHyperClassifier"
    reasoning:
        instructions: ->
            | Always transition to the start_agent subagent for every user turn.
        actions:
            go_to_start_agent: @utils.transition to @subagent.start_agent
                description: "Route to the start_agent subagent for answering."

